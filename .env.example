# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard → Project Settings → API).
#
# ATENÇÃO: use SOMENTE a chave "anon public" aqui. A chave "service_role"
# NUNCA deve aparecer no frontend nem em variáveis NEXT_PUBLIC_*.
#
# Sem estas variáveis, o Zion OS roda em modo demonstração (localStorage).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Execução real dos Agentes IA (v1.4) — chave da API Claude, criada em
# https://platform.claude.com. Fica SOMENTE no servidor (sem NEXT_PUBLIC_),
# nunca chega ao navegador. Sem ela, as execuções são simuladas.
ANTHROPIC_API_KEY=

# Opcional: modelo usado nas execuções (padrão: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8
