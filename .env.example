# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard → Project Settings → API).
#
# ATENÇÃO: use SOMENTE a chave "anon public" aqui. A chave "service_role"
# NUNCA deve aparecer no frontend nem em variáveis NEXT_PUBLIC_*.
#
# Sem estas variáveis, o Zion OS roda em modo demonstração (localStorage).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Provedor de IA (esteira + agentes). Configure UMA das opções.
# As chaves ficam SOMENTE no servidor (sem NEXT_PUBLIC_) e nunca chegam ao
# navegador. Sem nenhuma chave, as execuções rodam em modo simulado.
# Preferência automática: se GEMINI_API_KEY existir, usa Gemini.
# ============================================================

# Gemini (Google) — TEM PLANO GRATUITO. Crie a chave em
# https://aistudio.google.com/apikey  → cole aqui.
GEMINI_API_KEY=
# Opcional: modelo Gemini (padrão: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Claude (Anthropic) — chave criada em https://platform.claude.com (pré-pago).
ANTHROPIC_API_KEY=
# Opcional: modelo Claude (padrão: claude-opus-4-8)
# ANTHROPIC_MODEL=claude-opus-4-8

# Opcional: força um provedor mesmo com as duas chaves presentes.
# IA_PROVEDOR=gemini   # ou anthropic
