# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# (Dashboard → Project Settings → API).
#
# ATENÇÃO: use SOMENTE a chave "anon public" aqui. A chave "service_role"
# NUNCA deve aparecer no frontend nem em variáveis NEXT_PUBLIC_*.
#
# Sem estas variáveis, o Zion OS roda em modo demonstração (localStorage).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL base do próprio app — SERVER-ONLY (sem NEXT_PUBLIC_; nunca vai ao navegador).
# Usada no servidor para montar o redirectTo do convite (aceitação → /definir-senha).
# DEVE ser https e conter só a origin (SEM path/query/barra no fim). Sem esta
# variável válida, o envio de convites é recusado (não cai no Site URL).
APP_URL=https://example.vercel.app

# ============================================================
# Mercado Livre — SERVER-ONLY. Sem estas três, a integração não funciona:
# publicar, encerrar anúncio, consultar tarifa e reputação, tudo depende delas.
#
# ⚠️ ARMADILHA CONHECIDA: se estas variáveis também existirem no ambiente do
# SISTEMA OPERACIONAL, elas VENCEM as daqui — o Next não sobrescreve o que já
# está em process.env. Um valor velho no SO (de um app do ML antigo) faz o
# refresh do token falhar com "the client_id does not match the original",
# mesmo com o .env.local correto. Se acontecer, apague a variável do SO.
# ============================================================

# App ID do seu aplicativo em developers.mercadolivre.com.br/devcenter.
# NÃO é segredo: aparece na URL de autorização do OAuth.
ML_CLIENT_ID=

# Client Secret do MESMO aplicativo. É segredo — nunca versione.
# Precisa ser do mesmo app do ML_CLIENT_ID: um par trocado invalida o
# refresh_token que já está gravado no banco.
ML_CLIENT_SECRET=

# Para onde o ML devolve o vendedor depois de autorizar. DEVE estar cadastrada
# no aplicativo do ML e DEVE ser https — o ML bloqueia http://localhost na
# borda (CloudFront devolve 403 antes mesmo da tela de login). Por isso a
# conexão da conta só funciona pelo site publicado, nunca em desenvolvimento.
ML_REDIRECT_URI=https://example.vercel.app/cliente/conectar-ml

# ============================================================
# Provedor de IA (esteira + agentes). Configure UMA das opções.
# As chaves ficam SOMENTE no servidor (sem NEXT_PUBLIC_) e nunca chegam ao
# navegador. Sem nenhuma chave, as execuções rodam em modo simulado.
# Preferência automática: se ANTHROPIC_API_KEY existir, usa Claude.
# Era o inverso ("Gemini primeiro, free tier") até 05/08/2026, e o efeito é que
# QUAL inteligência atende a lojista era decidido pela presença de uma variável.
# Anexo (PDF/imagem) só funciona no Claude — o caminho Gemini recusa em vez de
# descartar o arquivo em silêncio.
# ============================================================

# Gemini (Google) — TEM PLANO GRATUITO. Crie a chave em
# https://aistudio.google.com/apikey  → cole aqui.
GEMINI_API_KEY=
# Opcional: modelo Gemini (padrão: gemini-2.5-flash).
# Alternativas: gemini-2.5-flash-lite (mais rápido/barato), gemini-flash-latest.
# GEMINI_MODEL=gemini-2.5-flash

# Claude (Anthropic) — chave criada em https://platform.claude.com (pré-pago).
ANTHROPIC_API_KEY=
# Opcional: modelo Claude (padrão: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Opcional: força um provedor mesmo com as duas chaves presentes.
# IA_PROVEDOR=gemini   # ou anthropic

# Opcional: o modelo e o esforço do CHAT (o copiloto da lojista).
# São separados de ANTHROPIC_MODEL de propósito: a esteira e a extração de
# catálogo usam Opus (chamada rara, erro entra no cadastro em escala); o chat usa
# Sonnet porque ali o que domina é custo por interação e latência — o laço
# reenvia o histórico até seis vezes por fala, e cada fala é alguém esperando.
# ANTHROPIC_MODELO_CONVERSA=claude-sonnet-5
# ANTHROPIC_ESFORCO_CONVERSA=medium   # low | medium | high

# ============================================================
# IMAGEM — outro eixo, outras chaves
# ============================================================
# A geração/edição de imagem NÃO usa o provedor de texto: ela tem seleção
# própria, porque o Claude não gera imagem. Ver `lib/agentes/provedorImagem.ts`.
#
# Hoje só o caminho do GEMINI está escrito. A chave da OpenAI pode estar
# presente sem quebrar nada — com as duas, o Gemini continua sendo o usado, e há
# teste em cima disso justamente para que pôr a chave da OpenAI não derrube a
# geração que está no ar.

# Usa a MESMA GEMINI_API_KEY acima. Opcional: o modelo de imagem.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI — a chave é aceita, e o CAMINHO AINDA NÃO EXISTE. Com
# IA_IMAGEM_PROVEDOR=openai a geração falha com mensagem explícita, de propósito:
# cair de volta para o Gemini em silêncio seria um provedor que "funciona"
# entregando outra coisa. O que falta é o formato da API de edição, e
# `GET /api/saude/ia?sondar=openai` (autenticado, roda no servidor) descobre.
OPENAI_API_KEY=

# Opcional: força o provedor de IMAGEM. Só isto alcança a OpenAI.
# IA_IMAGEM_PROVEDOR=gemini   # ou openai
