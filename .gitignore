# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example

# credenciais / segredos (NUNCA versionar)
# .env, .env.local e .env.*.local já são cobertos por ".env*" acima
# (com exceção só para os *.example). Aqui cobrimos variações de nome de
# arquivos de credenciais/segredos. NÃO ignore *.example.
credenciais*
credentials.md
secrets.md
senhas.md
chaves.md
*.secret
*.secrets
segredos*

# vercel
.vercel

# local tooling — o que e local fica de fora, mas a REGUA fica versionada:
# uma skill que orienta o codigo e parte do projeto, nao configuracao de
# maquina. Sem estas excecoes ela so entraria com `git add -f`, e todo
# mundo esquece o -f.
.claude/*
!.claude/skills/

# typescript
*.tsbuildinfo
next-env.d.ts

# Obsidian (estado do app na raiz — pessoal, nao versionar)
/.obsidian/

# E o RASCUNHO que o Obsidian cria na raiz do cofre: "Sem titulo.canvas",
# "Sem titulo.base", a nota do dia que ficou vazia. Sao 0 a 40 bytes cada e
# apareciam em todo `git status`, ensinando a passar o olho pela lista de
# untracked — que e onde um arquivo que IMPORTA se esconde.
/Sem t*.canvas
/Sem t*.base
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
