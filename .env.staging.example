# =====================================================================
# Zion OS — Exemplo de ambiente de STAGING (somente placeholders)
#
# Copie para .env.staging (que é IGNORADO pelo Git) e preencha com os
# valores do seu projeto de STAGING — NUNCA com valores de produção.
#
# Regras:
#  - Supabase de staging SEPARADO do de produção.
#  - App do Mercado Livre de teste (client id/secret próprios) quando possível.
#  - service_role e client_secret são SERVER-ONLY (sem NEXT_PUBLIC_).
#  - Ao colar na Vercel (Preview), confira que não sobrou `< >`, aspas ou barra.
# =====================================================================

# --- Supabase (staging) ---
# Público (navegador). URL = https://<ref>.supabase.co (sem barra no fim).
NEXT_PUBLIC_SUPABASE_URL=<SUPABASE_STAGING_URL>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<SUPABASE_STAGING_ANON_KEY>
# Server-only (worker do cron). NUNCA em NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<SUPABASE_STAGING_SERVICE_ROLE_KEY>
# URL base do app em STAGING — SERVER-ONLY (sem NEXT_PUBLIC_). https, só a origin
# (SEM barra no fim). Usada no redirectTo do convite (→ /definir-senha). Use a URL
# do Vercel Preview; NUNCA a de produção. Sem ela, o convite é recusado.
APP_URL=<VERCEL_PREVIEW_URL_HTTPS>

# --- IA (server-only). Configure ao menos uma; opcional para os testes de auth. ---
GEMINI_API_KEY=<OPTIONAL_STAGING_GEMINI_KEY>
# GEMINI_MODEL=gemini-2.5-flash            # opcional (default no código)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image # opcional (Estúdio IA)
OPENAI_API_KEY=<STAGING_OPENAI_KEY>         # a IA do projeto (ChatGPT) — texto, chat, PDF e imagem
# OPENAI_MODEL=gpt-5                       # opcional (padrão)
ANTHROPIC_API_KEY=<OPTIONAL_STAGING_ANTHROPIC_KEY>
# IA_PROVEDOR=openai                       # opcional: força openai|anthropic|gemini

# --- Mercado Livre (app de STAGING/teste) ---
ML_CLIENT_ID=<ML_STAGING_CLIENT_ID>
ML_CLIENT_SECRET=<ML_STAGING_CLIENT_SECRET>
# Deve bater EXATAMENTE com o Redirect URI cadastrado no app ML de staging
# e com o domínio do deploy de staging. Ex.: https://<preview-host>/cliente/conectar-ml
ML_REDIRECT_URI=<VERCEL_PREVIEW_OR_STAGING_CALLBACK>

# --- Worker / Cron (server-only) ---
# String aleatória; o Vercel Cron envia "Authorization: Bearer <CRON_SECRET>"
# e o worker /api/otimizar/worker valida. Opcional para os testes de auth.
CRON_SECRET=<STAGING_CRON_SECRET>
